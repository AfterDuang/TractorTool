<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Single product version source; CI/local publish can override with -p:Version. -->
    <Version Condition="'$(Version)' == ''">2.0.0</Version>
    <!-- Keep existing library binding identities stable for independently built plugins.
         The executable derives AssemblyVersion/FileVersion from Version using the .NET SDK. -->
    <AssemblyVersion Condition="'$(MSBuildProjectName)' != 'TractorTool'">1.0.0.0</AssemblyVersion>
  </PropertyGroup>
</Project>
