<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.ViewModels" x:Class="TractorTool.Views.LogEntriesView" x:DataType="vm:LogsViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="10,8" /></Style>
    <Style Selector="TextBlock.info"><Setter Property="Foreground" Value="{DynamicResource AppLogInfoBrush}" /></Style>
    <Style Selector="TextBlock.warning"><Setter Property="Foreground" Value="{DynamicResource AppLogWarningBrush}" /></Style>
    <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource AppLogErrorBrush}" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,18">
      <WrapPanel Margin="0,0,0,8">
        <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" PlaceholderText="全部级别" Width="130" Margin="0,0,10,8" AutomationProperties.Name="日志级别">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LogFilter"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Text="{Binding Search}" PlaceholderText="搜索来源或内容" Width="200" Margin="0,0,14,8" />
        <CheckBox Content="暂停记录显示" IsChecked="{Binding IsPaused}" Margin="0,0,14,8" VerticalAlignment="Center" />
        <Button Command="{Binding OpenDirectoryCommand}" Content="打开日志目录" Margin="0,0,8,8" />
        <Button Click="CopyLogs" Content="复制筛选记录" Margin="0,0,8,8" />
        <Button Command="{Binding MarkReadCommand}" Content="已读" Margin="0,0,0,8" ToolTip.Tip="清除当前所有错误提醒，保留日志记录" />
      </WrapPanel>
    <Grid Grid.Row="1">
      <ListBox x:Name="LogList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoScrollToSelectedItem="False" Background="{DynamicResource AppCardBrush}"
               BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="运行日志">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogRow">
            <Grid ColumnDefinitions="68,78,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="{Binding Time}" Classes="caption" TextWrapping="NoWrap" />
              <TextBlock Grid.Column="1" Text="{Binding Entry.LevelName}" Classes.info="{Binding IsInfo}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="{Binding Entry.Source}" Classes="caption" TextTrimming="CharacterEllipsis" MaxLines="1" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" MaxLines="2" Margin="0,4,0,0"
                         Classes.info="{Binding IsInfo}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="没有符合条件的记录" IsVisible="{Binding IsEmpty}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
    <Expander Grid.Row="2" Header="记录详情" IsVisible="{Binding HasSelection}" Margin="0,12,0,0" HorizontalAlignment="Stretch">
      <TextBox Text="{Binding SelectedText, Mode=OneWay}"
             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12"
             ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="所选记录详情" />
    </Expander>
    <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="4">
      <TextBlock Text="{Binding Status}" Classes="caption" />
      <TextBlock Text="{Binding WriteError}" Classes="error" />
    </StackPanel>
  </Grid>
</UserControl>
