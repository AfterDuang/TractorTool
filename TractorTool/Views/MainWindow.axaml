<fa:FAAppWindow xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Windowing" xmlns:nav="using:FluentAvalonia.UI.Controls"
        xmlns:ui="using:TractorTool.UI.Controls" xmlns:vm="using:TractorTool.ViewModels"
        x:Class="TractorTool.Views.MainWindow" x:DataType="vm:MainViewModel"
        Width="1120" Height="760" MinWidth="720" MinHeight="540"
        Title="TractorTool" Icon="/Assets/tractortool.png"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}">
  <Grid RowDefinitions="Auto,*">
    <!-- Avalonia 12 needs an explicit non-client role on the custom surface above the default title bar. -->
    <Border x:Name="TitleBarDragRegion" Classes="themeSurface" WindowDecorationProperties.ElementRole="TitleBar"
            Background="{DynamicResource AppSidebarBrush}" Height="32" Padding="12,0,160,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
        <Image Source="/Assets/tractortool.png" Width="16" Height="16" />
        <TextBlock Text="TractorTool" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <nav:FANavigationView x:Name="NavigationView" Grid.Row="1" Classes="shell"
          MenuItemsSource="{Binding Navigation}" FooterMenuItemsSource="{Binding FooterNavigation}"
          SelectedItem="{Binding SelectedNavigation, Mode=OneWay}" IsSettingsVisible="False"
          PaneDisplayMode="Left" IsPaneOpen="True"
          IsPaneToggleButtonVisible="False" IsBackButtonVisible="False" AlwaysShowHeader="False">
      <nav:FANavigationView.Resources>
        <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
      </nav:FANavigationView.Resources>
      <nav:FANavigationView.MenuItemTemplate>
        <DataTemplate x:DataType="vm:NavigationItem">
          <nav:FANavigationViewItem Classes="rail" Content="{Binding}" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
            <nav:FANavigationViewItem.ContentTemplate>
              <DataTemplate x:DataType="vm:NavigationItem">
                <StackPanel Spacing="6" Margin="0,8" Width="60" HorizontalAlignment="Center">
                  <Grid Height="30">
                    <ui:ToolIcon Kind="{Binding Icon}" ImageSource="{Binding ImageSource}" FontSize="28" Foreground="{DynamicResource AppTextBrush}" />
                    <Border IsVisible="{Binding HasErrors}" Background="{DynamicResource AppErrorBadgeBrush}" CornerRadius="10"
                            MinWidth="18" Height="18" Padding="4,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,-6,0,0"
                            ToolTip.Tip="{Binding ErrorDescription}" AutomationProperties.Name="{Binding ErrorDescription}">
                      <TextBlock Text="{Binding UnreadErrors}" Foreground="White" FontSize="10" FontWeight="SemiBold" TextWrapping="NoWrap"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Title}" FontSize="10" LineHeight="14" TextAlignment="Center"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
              </DataTemplate>
            </nav:FANavigationViewItem.ContentTemplate>
          </nav:FANavigationViewItem>
        </DataTemplate>
      </nav:FANavigationView.MenuItemTemplate>
      <Border Classes="themeSurface" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
          <!-- Shell headers follow the current presenter, including resets and cancelled navigation. -->
          <Grid Margin="28,26,28,20" IsVisible="{Binding ShowPageHeader}"
                Opacity="{Binding #PagePresenter.Child?.Opacity, FallbackValue=1, TargetNullValue=1}"
                RenderTransform="{Binding #PagePresenter.Child?.RenderTransform}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding PageTitle}" Classes="pageTitle" />
              <TextBlock Text="{Binding PageDescription}" Classes="muted" />
            </StackPanel>
          </Grid>
          <ui:PageHost x:Name="PagePresenter" Grid.Row="1" Classes.edgeScroll="{Binding HasPageScroll}" Classes.workspace="{Binding !ShowPageHeader}" />
          <TextBlock Grid.Row="2" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" Classes="caption" Margin="28,10,28,12" />
        </Grid>
      </Border>
    </nav:FANavigationView>
    <!-- Startup owns the same window and title bar; navigation is revealed after data is ready. -->
    <Grid x:Name="StartupPanel" Grid.Row="1" ColumnDefinitions="72,*" IsVisible="False">
      <Border Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" />
      <Grid Grid.Column="1" Margin="40,32">
        <StackPanel Spacing="20" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <TextBlock x:Name="StartupStatus" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
          <ProgressBar x:Name="StartupProgress" Height="4" MinHeight="4" IsIndeterminate="False"
                       HorizontalAlignment="Stretch" AutomationProperties.Name="启动进度" />
          <TextBox x:Name="StartupError" IsVisible="False" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" MaxHeight="280" AutomationProperties.Name="启动错误详情" />
          <Button x:Name="StartupExit" Content="退出" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</fa:FAAppWindow>
