<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:TractorTool.ViewModels"
             x:Class="TractorTool.Views.ExternalToolsView" x:DataType="vm:ExternalToolsViewModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageBody" Spacing="16">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="清理未引用依赖" Command="{Binding CleanCommand}" Margin="12,0,0,0" />
        <TextBlock Text="{Binding Summary}" Classes="caption" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock Text="{Binding Error}" Classes="caption" IsVisible="{Binding HasError}" />
      <Border Classes="card" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="8">
          <TextBlock Text="暂时没有外部依赖" FontWeight="SemiBold" />
          <TextBlock Text="插件需要的工具会显示在这里，首次下载前会请你确认。" Classes="caption" />
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PackageCardViewModel">
            <Button Classes="toolCard" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                    Command="{Binding $parent[UserControl].((vm:ExternalToolsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                  <WrapPanel>
                    <TextBlock Text="{Binding Attribution}" Classes="caption" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding StatusText}" Classes="caption" />
                  </WrapPanel>
                  <TextBlock Text="{Binding RequiredBy}" Classes="caption" />
                  <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsBusy}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="›" FontSize="22" Margin="16,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
