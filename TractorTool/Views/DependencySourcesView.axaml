<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.ViewModels" xmlns:packages="clr-namespace:TractorTool.Core.Packages;assembly=TractorTool.Core"
             x:Class="TractorTool.Views.DependencySourcesView" x:DataType="vm:ExternalToolsViewModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageBody" Spacing="16">
      <TextBlock Text="插件声明固定版本和锁文件，软件从已配置来源准备所需依赖。" Classes="caption" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Sources}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="packages:DependencySource">
            <Border Classes="card" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                  <WrapPanel><TextBlock Text="默认来源 · " IsVisible="{Binding IsDefault}" Classes="caption" /><TextBlock Text="{Binding KindLabel}" Classes="caption" /></WrapPanel>
                  <SelectableTextBlock Text="{Binding Url}" TextWrapping="Wrap" Classes="caption" />
                </StackPanel>
                <Button Grid.Column="1" Content="移除" IsVisible="{Binding !IsDefault}" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:ExternalToolsViewModel)DataContext).RemoveSourceCommand}" CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Expander Header="添加依赖来源" IsExpanded="{Binding ShowSourceForm, Mode=TwoWay}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12" Margin="0,12,0,0" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Text="来源类型" />
          <ComboBox ItemsSource="{Binding SourceKinds}" SelectedIndex="{Binding SourceKindIndex}" HorizontalAlignment="Stretch" />
          <TextBlock Text="{Binding SourceHelp}" TextWrapping="Wrap" Classes="caption" />
          <TextBlock Text="来源名称" />
          <TextBox Text="{Binding SourceName}" PlaceholderText="例如：团队依赖" MaxLength="80" />
          <TextBlock Text="来源地址" />
          <TextBox Text="{Binding SourceAddress}" PlaceholderText="{Binding SourcePlaceholder}" />
          <Button Content="添加" Command="{Binding AddSourceCommand}" Classes="accent" />
        </StackPanel>
      </Expander>
      <TextBlock Text="移除来源不会删除已安装依赖。来源配置不会改写插件锁文件或升级已装版本。" Classes="caption" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
