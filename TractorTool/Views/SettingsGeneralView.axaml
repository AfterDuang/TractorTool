<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.ViewModels" xmlns:ui="using:TractorTool.UI.Controls"
             x:Class="TractorTool.Views.SettingsGeneralView" x:DataType="vm:SettingsViewModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageBody">
      <ItemsControl ItemsSource="{Binding GeneralPages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsPage">
            <Button Classes="toolCard" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).NavigateCommand}" CommandParameter="{Binding}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ui:ToolIcon Kind="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" Classes="caption" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" FontSize="22" Margin="16,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
