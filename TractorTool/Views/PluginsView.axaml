<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.ViewModels" xmlns:ui="using:TractorTool.UI.Controls"
             x:Class="TractorTool.Views.PluginsView" x:DataType="vm:PluginsViewModel"
             Background="Transparent" DragDrop.AllowDrop="True">
  <Grid>
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageBody" Spacing="20">
      <ui:SettingRow Header="本地插件" Description="拖入 ZIP 或选择文件安装，变更在重启后生效。" Icon="Folder">
        <WrapPanel>
          <Button Content="安装 / 更新" Command="{Binding InstallCommand}" Classes="accent" Margin="0,0,8,0" />
          <Button Content="打开目录" Command="{Binding OpenDirectoryCommand}" />
        </WrapPanel>
      </ui:SettingRow>
      <SelectableTextBlock Text="{Binding PluginRoot}" Classes="caption" TextWrapping="Wrap" Margin="4,-8,4,0" />
      <TextBlock Text="{Binding OperationStatus}" Classes="caption" IsVisible="{Binding HasOperationStatus}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
      <StackPanel IsVisible="{Binding IsLoading}" Spacing="8">
        <TextBlock Text="{Binding Summary}" Classes="caption" />
        <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="3" />
      </StackPanel>
      <Border Classes="card" IsVisible="{Binding HasDirectoryError}">
        <StackPanel Spacing="10">
          <TextBlock Text="插件目录不可用" Classes="sectionTitle" />
          <TextBlock Text="{Binding DirectoryError}" />
          <Button Content="查看日志" Command="{Binding ShowLogsCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="28,44">
        <StackPanel HorizontalAlignment="Center" MaxWidth="430" Spacing="16">
          <Border Classes="iconTile" Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center">
            <ui:ToolIcon Kind="Tools" FontSize="34" />
          </Border>
          <TextBlock Text="还没有安装工具" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
          <TextBlock Text="添加插件后，工具会出现在左侧。每个工具拥有自己的页面，也会遵循相同的外观设置。" Classes="muted" TextAlignment="Center" />
          <Button Content="打开插件目录" Command="{Binding OpenDirectoryCommand}" Classes="accent" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasItems}">
        <TextBlock Text="{Binding Summary}" Classes="sectionTitle" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Width="190" Text="{Binding Search}" PlaceholderText="查找插件" AutomationProperties.Name="查找插件" />
      </Grid>
      <TextBlock Text="没有找到匹配的插件。" IsVisible="{Binding NoMatches}" Classes="muted" Margin="4,12" />
      <ItemsControl ItemsSource="{Binding FilteredItems}" IsEnabled="{Binding !IsBusy}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PluginCard">
            <Border Classes="card" Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                <Border Classes="iconTile" Margin="0,0,18,0"><ui:ToolIcon Kind="{Binding Icon}" ImageSource="{Binding ImageSource}" FontSize="36" /></Border>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="{Binding Name}" Classes="sectionTitle" />
                  <TextBlock Text="{Binding Description}" Classes="muted" />
                  <TextBlock Text="{Binding Version, StringFormat='版本 {0}'}" Classes="caption" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="10" Margin="12,0,0,0" MinWidth="76">
                  <ToggleSwitch IsChecked="{Binding RequestedEnabled, Mode=OneWay}" IsCheckedChanged="OnPluginEnabledChanged"
                                IsEnabled="{Binding CanToggle}" OnContent="启用" OffContent="禁用"
                                AutomationProperties.Name="{Binding Name}" ToolTip.Tip="启用状态（重启后生效）" />
                  <TextBlock Text="{Binding State}" TextAlignment="Right" Classes="caption" />
                  <Button Content="打开工具" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" IsVisible="{Binding HasIssue}" Margin="0,14,0,0" />
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="10" Margin="0,14,0,0">
                  <TextBlock Text="{Binding PendingText}" IsVisible="{Binding HasPending}" Classes="caption" />
                  <WrapPanel>
                    <Button Content="卸载" Command="{Binding UninstallCommand}" IsVisible="{Binding CanManage}" Margin="0,0,8,0" />
                    <Button Content="回退版本" Command="{Binding RollbackCommand}" IsVisible="{Binding CanRollback}" Margin="0,0,8,0" />
                    <Button Content="取消变更" Command="{Binding CancelChangeCommand}" IsVisible="{Binding CanCancelChange}" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
    <Border x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False" Margin="8"
            Background="{DynamicResource AppCardBrush}" Opacity="0.96" BorderThickness="2"
            BorderBrush="{DynamicResource SystemAccentColor}" CornerRadius="10">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <ui:ToolIcon Kind="Tools" FontSize="44" HorizontalAlignment="Center" />
        <TextBlock Text="松开以安装插件" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="仅安装你信任的 ZIP 插件包" Classes="caption" TextAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
