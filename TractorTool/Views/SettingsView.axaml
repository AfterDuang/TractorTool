<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.ViewModels" xmlns:ui="using:TractorTool.UI.Controls"
             x:Class="TractorTool.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:SettingsPage">
      <TextBlock Text="{Binding Title}" Margin="4,6" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
  </UserControl.Resources>
  <Grid x:Name="Layout" ColumnDefinitions="180,*" RowDefinitions="Auto,*">
    <ComboBox x:Name="CompactNavigation" Grid.ColumnSpan="2" IsVisible="False" Margin="0,0,28,16"
              HorizontalAlignment="Stretch" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
              ItemTemplate="{StaticResource CategoryTemplate}" AutomationProperties.Name="设置分类" />
    <ScrollViewer x:Name="Sidebar" Grid.Row="1" Margin="0,0,20,0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8">
        <TextBlock Text="软件设置" Classes="caption" Margin="8,0,0,4" />
        <ListBox ItemsSource="{Binding SoftwareSettings}" SelectedItem="{Binding SelectedPage, Mode=OneWay}"
                 ItemTemplate="{StaticResource CategoryTemplate}" SelectionChanged="CategoryChanged" Background="Transparent" />
        <TextBlock Text="插件设置" Classes="caption" Margin="8,20,0,4" IsVisible="{Binding HasPluginSettings}" />
        <ListBox ItemsSource="{Binding PluginSettings}" SelectedItem="{Binding SelectedPage, Mode=OneWay}"
                 ItemTemplate="{StaticResource CategoryTemplate}" SelectionChanged="CategoryChanged" Background="Transparent" />
      </StackPanel>
    </ScrollViewer>
    <ui:PageHost x:Name="SectionPresenter" Grid.Row="1" Grid.Column="1" />
  </Grid>
</UserControl>
