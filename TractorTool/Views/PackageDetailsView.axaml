<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:TractorTool.ViewModels"
             x:Class="TractorTool.Views.PackageDetailsView" x:DataType="vm:PackageCardViewModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageBody" Spacing="16">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Attribution}" Classes="caption" />
          <TextBlock Text="{Binding Availability}" Classes="caption" />
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SizeText}" Classes="caption" />
          <TextBlock Text="{Binding RequiredBy}" />
          <TextBlock Text="{Binding Users}" IsVisible="{Binding HasUsers}" />
          <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" />
          <WrapPanel>
            <Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" Classes="accent" />
            <Button Content="取消下载" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
            <Button Content="清理依赖" Command="{Binding RemoveCommand}" IsVisible="{Binding IsInstalled}" Margin="8,0,0,0" />
          </WrapPanel>
          <TextBlock Text="清理仅对没有插件引用且未在使用的依赖开放。" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsInstalled}" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="提供的工具" FontWeight="SemiBold" />
          <SelectableTextBlock Text="{Binding ToolNames}" TextWrapping="Wrap" />
          <TextBlock Text="当前下载地址" FontWeight="SemiBold" Margin="0,8,0,0" />
          <SelectableTextBlock Text="{Binding DownloadUri}" TextWrapping="Wrap" />
          <TextBlock Text="SHA256 校验值" FontWeight="SemiBold" Margin="0,8,0,0" />
          <SelectableTextBlock Text="{Binding Sha256}" TextWrapping="Wrap" />
          <TextBlock Text="项目来源" FontWeight="SemiBold" Margin="0,8,0,0" />
          <SelectableTextBlock Text="{Binding Source}" TextWrapping="Wrap" />
          <TextBlock Text="存储位置" FontWeight="SemiBold" Margin="0,8,0,0" />
          <SelectableTextBlock Text="{Binding Directory}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
