<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TractorTool.Plugins.ClipboardHistory"
             x:Class="TractorTool.Plugins.ClipboardHistory.ClipboardHistoryView" x:DataType="local:ClipboardHistoryViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
      <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" />
    </Grid>
    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" />
    <ListBox Grid.Row="2" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="local:HistoryEntry">
          <Border Classes="card" Margin="0,0,8,8">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Timestamp}" Classes="caption" />
              <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Detail}" Classes="caption" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
