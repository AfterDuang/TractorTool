<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.Plugins.VideoExport" x:Class="TractorTool.Plugins.VideoExport.MediaInfoView" x:DataType="vm:VideoViewModel">
  <Grid x:Name="Columns" ColumnDefinitions="320,20,*" Margin="28,0,28,0">
    <ScrollViewer x:Name="InputScroll" Classes="pageScroll">
      <vm:VideoInputView Margin="0,0,4,12" />
    </ScrollViewer>
    <Border x:Name="ReportPanel" Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="18,14">
          <TextBlock Text="视频信息" Classes="sectionTitle" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="复制全部" Click="CopyReport" IsEnabled="{Binding HasMediaReport}" Classes="quiet" />
        </Grid>
        <TextBox Grid.Row="1" Text="{Binding MediaReport, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                 PlaceholderText="拖入视频后，在这里查看媒体信息。" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                 Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="18,4,18,18"
                 TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="完整视频信息" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
