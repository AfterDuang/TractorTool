<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.Plugins.VideoExport" x:Class="TractorTool.Plugins.VideoExport.MediaInfoView" x:DataType="vm:VideoViewModel">
  <Grid x:Name="Columns" ColumnDefinitions="360,16,*" Margin="28,0,0,0">
    <ScrollViewer x:Name="InputScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
      <vm:VideoInputView Margin="0,0,8,12" />
    </ScrollViewer>
    <Grid x:Name="ReportPanel" Grid.Column="2" RowDefinitions="Auto,*" Margin="0,0,0,4">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,28,12">
        <TextBlock Text="视频信息" Classes="sectionTitle" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="复制全部" Click="CopyReport" IsEnabled="{Binding HasMediaReport}" />
      </Grid>
      <TextBox Grid.Row="1" Text="{Binding MediaReport, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
               PlaceholderText="将视频拖入左侧，识别结果会显示在这里。" FontFamily="Cascadia Mono, Consolas" FontSize="13"
               TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="18" AutomationProperties.Name="完整视频信息" />
    </Grid>
  </Grid>
</UserControl>
