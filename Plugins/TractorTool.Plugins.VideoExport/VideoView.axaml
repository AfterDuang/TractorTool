<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.Plugins.VideoExport" xmlns:ui="using:TractorTool.UI.Controls"
             x:Class="TractorTool.Plugins.VideoExport.VideoView" x:DataType="vm:VideoViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid x:Name="Header" ColumnDefinitions="*,Auto" Margin="28,24,28,18" RowDefinitions="Auto,Auto">
      <TextBlock Text="视频工具" Classes="pageTitle" />
      <TextBlock Grid.Row="1" Text="多格式导出与视频信息提取" Classes="muted" Margin="0,4,0,0" />
      <TabStrip x:Name="Functions" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" SelectionChanged="FunctionChanged">
        <TabStripItem Content="多格式导出" /><TabStripItem Content="视频信息" />
      </TabStrip>
    </Grid>
    <ui:PageHost x:Name="Workspace" Grid.Row="1" />
    <StackPanel Grid.Row="2" Margin="28,8,28,12" Spacing="4">
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasStatus}">
        <TextBlock Text="{Binding Status}" Classes="caption" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="取消当前操作" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
      </Grid>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" />
      <StackPanel IsVisible="{Binding HasSettingsError, FallbackValue=False}" Spacing="4">
        <TextBlock Text="{Binding SettingsError}" /><Button Content="重试保存预设" Command="{Binding RetrySettingsCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
