<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.Plugins.VideoExport" x:Class="TractorTool.Plugins.VideoExport.ExportWorkspaceView" x:DataType="vm:VideoViewModel">
  <Grid x:Name="Columns" ColumnDefinitions="380,18,*" Margin="28,0,0,0">
    <ScrollViewer Classes="pageScroll">
      <StackPanel Spacing="16" Margin="0,0,10,12">
        <vm:VideoInputView />
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="12" IsEnabled="{Binding CanEditPresets}">
            <TextBlock Text="导出设置" Classes="sectionTitle" />
            <TextBlock Text="预设名称" /><TextBox Text="{Binding PresetName}" MaxLength="80" AutomationProperties.Name="预设名称" />
            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="容器格式" /><TextBlock Grid.Column="2" Text="编码方式" />
              <ComboBox Grid.Row="1" ItemsSource="{Binding Containers}" SelectedItem="{Binding Container}" HorizontalAlignment="Stretch" Margin="0,6,0,0" AutomationProperties.Name="容器格式">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ExportChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Encoders}" SelectedItem="{Binding Encoder}" HorizontalAlignment="Stretch" Margin="0,6,0,0" AutomationProperties.Name="编码方式">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ExportChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="保持源尺寸" VerticalAlignment="Center" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepSize}" OnContent="" OffContent="" AutomationProperties.Name="保持源尺寸" /></Grid>
            <Grid ColumnDefinitions="*,24,*" IsVisible="{Binding !KeepSize}">
              <NumericUpDown Value="{Binding OutputWidth}" Minimum="2" Maximum="8192" Increment="2" AutomationProperties.Name="输出宽度像素" />
              <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center" />
              <NumericUpDown Grid.Column="2" Value="{Binding OutputHeight}" Minimum="2" Maximum="8192" Increment="2" AutomationProperties.Name="输出高度像素" />
            </Grid>
            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="视频码率 · Mbps" /><TextBlock Grid.Column="2" Text="音频码率 · kbps" />
              <NumericUpDown Grid.Row="1" Value="{Binding VideoMbps}" Minimum="0.1" Maximum="200" Increment="0.5" FormatString="0.###" Margin="0,6,0,0" AutomationProperties.Name="视频码率 Mbps" />
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding AudioKbps}" Minimum="32" Maximum="512" Increment="32" Margin="0,6,0,0" AutomationProperties.Name="音频码率 kbps" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="替换第一帧" VerticalAlignment="Center" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding ReplaceFirstFrame}" OnContent="" OffContent="" AutomationProperties.Name="替换第一帧" /></Grid>
            <TextBlock Text="{Binding EstimatedSize}" Classes="caption" />
            <TextBlock Text="输出文件夹" />
            <TextBlock Text="{Binding OutputDirectory}" Classes="caption" />
            <Button Content="选择文件夹" Click="ChooseOutput" HorizontalAlignment="Left" />
            <WrapPanel ItemSpacing="8" LineSpacing="8" Margin="0,4,0,0">
              <Button Content="{Binding EditorAction}" Command="{Binding SavePresetCommand}" Classes="accent" />
              <Button Content="取消编辑" Command="{Binding ResetEditorCommand}" IsVisible="{Binding IsEditingPreset}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="PresetPanel" Grid.Column="2" RowDefinitions="Auto,*,Auto">
      <TextBlock Text="导出预设" Classes="sectionTitle" Margin="0,0,28,12" />
      <ScrollViewer Grid.Row="1" Classes="pageScroll">
        <Grid Margin="0,0,28,12">
          <ItemsControl x:Name="PresetItems" ItemsSource="{Binding Presets}" SizeChanged="CardsResized">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="320" ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExportPreset">
                <Border Classes="card" Padding="18">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Name}">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                      </CheckBox>
                      <Button Grid.Column="1" Content="×" Classes="quiet" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="删除预设" ToolTip.Tip="删除预设" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Classes="caption" MinHeight="54" />
                    <TextBlock Text="{Binding EstimatedSize}" Classes="caption" />
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <Button Content="编辑" Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}" />
                      <Button Content="复制" Command="{Binding CopyCommand}" IsEnabled="{Binding CanEdit}" />
                      <Button Content="取消此项" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
                    </WrapPanel>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" />
                    <TextBlock Text="{Binding Status}" Classes="caption" />
                    <TextBlock Text="{Binding Error}" Classes="caption" />
                    <SelectableTextBlock Text="{Binding OutputPath}" TextWrapping="Wrap" FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="card" IsVisible="{Binding !HasPresets}" VerticalAlignment="Top">
            <StackPanel Spacing="8"><TextBlock Text="添加第一个预设" Classes="sectionTitle" /><TextBlock Text="在左侧设置格式与参数，然后点击“添加预设”。" Classes="muted" /></StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="0,12,28,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
        <Button Content="{Binding ExportLabel}" Command="{Binding ExportCommand}" Classes="accent" HorizontalAlignment="Right" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
