<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.Plugins.VideoExport" x:Class="TractorTool.Plugins.VideoExport.ExportWorkspaceView" x:DataType="vm:VideoViewModel">
  <Grid x:Name="Columns" ColumnDefinitions="360,20,*" Margin="28,0,0,0">
    <ScrollViewer Classes="pageScroll">
      <StackPanel Spacing="16" Margin="0,0,4,12">
        <vm:VideoInputView />
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="12" IsEnabled="{Binding CanEditPresets}">
            <TextBlock Text="{Binding EditorTitle}" Classes="sectionTitle" />
            <TextBox Text="{Binding PresetName}" PlaceholderText="预设名称" MaxLength="80" AutomationProperties.Name="预设名称" />
            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="输出格式" /><TextBlock Grid.Column="2" Text="码率模式" />
              <ComboBox Grid.Row="1" ItemsSource="{Binding Containers}" SelectedItem="{Binding Container}" HorizontalAlignment="Stretch" Margin="0,6,0,0" AutomationProperties.Name="输出格式">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ExportFormat"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding RateControls}" SelectedItem="{Binding RateControl}" HorizontalAlignment="Stretch" Margin="0,6,0,0" AutomationProperties.Name="码率模式">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ExportChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="视频码率 · Mbps" /><TextBlock Grid.Column="2" Text="音频码率 · kbps" />
              <NumericUpDown Grid.Row="1" Value="{Binding VideoMbps}" Minimum="0.1" Maximum="200" Increment="0.5" FormatString="0.###" Margin="0,6,0,0" AutomationProperties.Name="视频码率 Mbps" />
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding AudioKbps}" Minimum="32" Maximum="512" Increment="32" Margin="0,6,0,0" AutomationProperties.Name="音频码率 kbps" />
            </Grid>
            <Expander Header="画面选项" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding ShowPictureOptions}">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="保持源尺寸" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepSize}" OnContent="" OffContent="" AutomationProperties.Name="保持源尺寸" />
                </Grid>
                <Grid ColumnDefinitions="*,24,*" IsVisible="{Binding !KeepSize}">
                  <NumericUpDown Value="{Binding OutputWidth}" Minimum="2" Maximum="8192" Increment="2" AutomationProperties.Name="输出宽度像素" />
                  <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <NumericUpDown Grid.Column="2" Value="{Binding OutputHeight}" Minimum="2" Maximum="8192" Increment="2" AutomationProperties.Name="输出高度像素" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="替换第一帧" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReplaceFirstFrame}" OnContent="" OffContent="" AutomationProperties.Name="替换第一帧" />
                </Grid>
              </StackPanel>
            </Expander>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="{Binding EditorAction}" Command="{Binding SavePresetCommand}" Classes="accent" />
              <Button Content="取消编辑" Command="{Binding ResetEditorCommand}" IsVisible="{Binding IsEditingPreset}" Classes="quiet" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="PresetPanel" Grid.Column="2" RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,28,12">
        <TextBlock Text="导出预设" Classes="sectionTitle" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" Classes="caption" VerticalAlignment="Center" />
      </Grid>
      <ScrollViewer Grid.Row="1" Classes="pageScroll">
        <Grid Margin="0,0,28,16">
          <ItemsControl x:Name="PresetItems" ItemsSource="{Binding Presets}" SizeChanged="CardsResized">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="300" ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExportPreset">
                <Border Classes="card" Padding="16" VerticalAlignment="Top">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Name}">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" />
                      </CheckBox>
                      <Button Grid.Column="1" Content="×" Classes="quiet" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="删除预设" ToolTip.Tip="删除预设" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Classes="caption" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding EstimatedSize}" Classes="caption" IsVisible="{Binding HasEstimate}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Content="编辑" Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}" Classes="quiet" />
                        <Button Content="复制" Command="{Binding CopyCommand}" IsEnabled="{Binding CanEdit}" Classes="quiet" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding HasProgress}">
                      <ProgressBar Value="{Binding Progress}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Status}" Classes="caption" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Classes="quiet" />
                      </Grid>
                    </StackPanel>
                    <TextBlock Text="{Binding ExecutionInfo}" Classes="caption" IsVisible="{Binding HasExecutionInfo}" />
                    <TextBlock Text="{Binding Error}" Classes="caption" IsVisible="{Binding HasError}" />
                    <SelectableTextBlock Text="{Binding OutputPath}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding HasOutput}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="card" IsVisible="{Binding !HasPresets}" VerticalAlignment="Top">
            <StackPanel Spacing="8"><TextBlock Text="还没有预设" Classes="sectionTitle" /><TextBlock Text="设置左侧参数，添加要导出的版本。" Classes="muted" /></StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="0,12,28,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="10">
          <TextBlock Text="{Binding OutputFolderLabel}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding OutputDirectory}" VerticalAlignment="Center" Classes="caption" />
          <Button Grid.Column="1" Content="选择输出位置" Click="ChooseOutput" IsEnabled="{Binding !IsBusy}" Classes="quiet" />
          <Button Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding ExportLabel}" Command="{Binding ExportCommand}" Classes="accent" HorizontalAlignment="Right" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
