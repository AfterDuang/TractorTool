<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TractorTool.Plugins.SystemHud"
             x:Class="TractorTool.Plugins.SystemHud.HudCard" x:DataType="local:HudDisplay">
  <Border Width="320" Height="124" Padding="22,16" CornerRadius="22"
          Background="#EF191C21" BorderBrush="{Binding Accent}" BorderThickness="1">
    <Grid ColumnDefinitions="36,*" RowDefinitions="Auto,*,Auto,Auto">
      <Path Grid.RowSpan="2" Data="M 18,0 L 2,22 L 13,22 L 7,42 L 31,15 L 19,15 Z"
            Fill="{Binding Accent}" Width="28" Height="38" Stretch="Uniform" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#BCC3CE" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Value}" Foreground="{Binding Accent}"
                 FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Foreground="#D1D6DE"
                 FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
      <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Height="3" Margin="0,7,0,0" Minimum="0" Maximum="100"
                   Value="{Binding Progress}" IsVisible="{Binding HasPercent}"
                   Foreground="{Binding Accent}" Background="#41454C" />
    </Grid>
  </Border>
</UserControl>
