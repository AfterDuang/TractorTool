<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TractorTool.Plugins.SystemHud" xmlns:ui="using:TractorTool.UI.Controls"
             x:Class="TractorTool.Plugins.SystemHud.HudSettingsView" x:DataType="local:HudModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageBody" Spacing="12">
      <TextBlock Text="{Binding StartupError}" IsVisible="{Binding HasStartupError}" TextWrapping="Wrap" Foreground="{DynamicResource AppLogErrorBrush}" />
      <ui:SettingRow Header="启用 HUD" Description="关闭主窗口到托盘后，HUD 仍可运行。" Icon="Info">
        <ToggleSwitch IsChecked="{Binding Enabled}" AutomationProperties.Name="启用 HUD" />
      </ui:SettingRow>
      <ui:SettingRow Header="默认常驻显示" Description="保存后立即生效，也作为下次启动时的显示方式。关闭时仅在电源提醒或草稿预览时显示。" Icon="Info">
        <ToggleSwitch IsChecked="{Binding AlwaysVisible}" AutomationProperties.Name="常驻显示" />
      </ui:SettingRow>
      <ui:SettingRow Header="电源变化提醒" Description="插入或拔出电源时显示电量；无电池设备会明确提示。" Icon="Info">
        <ToggleSwitch IsChecked="{Binding PowerReminder}" AutomationProperties.Name="电源变化提醒" />
      </ui:SettingRow>

      <ui:SettingRow Header="点击穿透" Description="默认关闭，可点击摘要展开详情或拖动位置。开启后鼠标操作下方窗口，HUD 无法点击或拖动。" Icon="Info">
        <ToggleSwitch IsChecked="{Binding ClickThrough}" AutomationProperties.Name="点击穿透" />
      </ui:SettingRow>
      <ui:SettingRow Header="HUD 大小" Description="调整桌面卡片的缩放比例，位置仍保持在屏幕内。" Icon="Info">
        <NumericUpDown Value="{Binding Scale}" Minimum="0.6" Maximum="2" Increment="0.1" FormatString="0.0" Width="140" AutomationProperties.Name="HUD 缩放比例" />
      </ui:SettingRow>
      <ui:SettingRow Header="显示动画" Description="出现时淡入，同时遵循软件的界面动画开关。" Icon="Motion">
        <ToggleSwitch IsChecked="{Binding Animate}" AutomationProperties.Name="显示动画" />
      </ui:SettingRow>
      <ui:SettingRow Header="启用硬件传感器" Description="保存后在主页面检测并选择 CPU / GPU 传感器。" Icon="Info">
        <ToggleSwitch IsChecked="{Binding HardwareEnabled}" AutomationProperties.Name="启用硬件传感器" />
      </ui:SettingRow>
      <TextBlock Text="按需读取 CPU / GPU 温度、负载等数据。部分读数需要管理员权限及已安装的 PawnIO；插件不会自动提权或安装驱动。保存后在主页面检测并选择传感器。" Classes="caption" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="保存偏好" Classes="accent" Command="{Binding ApplyPreferencesCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="caption" />
      <Expander Header="DeepSeek 账号" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="10" Margin="0,12,0,0">
          <TextBlock Text="只查询官方余额。密钥使用 Windows 当前用户加密保存；换电脑或 Windows 账号后需要重新输入，不会写入方案或日志。" Classes="caption" TextWrapping="Wrap" />
          <TextBox Text="{Binding KeyInput}" PasswordChar="●" PlaceholderText="输入新的 API Key" MaxLength="1024" AutomationProperties.Name="DeepSeek API Key" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="保存密钥" Command="{Binding SaveKeyCommand}" />
            <Button Content="清除密钥" Command="{Binding ClearKeyCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding KeyStatus}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
