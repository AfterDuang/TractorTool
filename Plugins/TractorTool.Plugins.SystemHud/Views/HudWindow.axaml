<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TractorTool.Plugins.SystemHud"
        x:Class="TractorTool.Plugins.SystemHud.HudWindow" x:DataType="local:HudModel"
        Title="系统数据HUD" Width="{x:Static local:HudWindow.FrameWidth}" Height="{x:Static local:HudWindow.FrameHeight}" CanResize="False" ShowActivated="False"
        ShowInTaskbar="False" WindowDecorations="None" Topmost="True" Background="Transparent"
        TransparencyLevelHint="Transparent" WindowStartupLocation="Manual">
  <Viewbox Stretch="Uniform">
    <Grid Width="{x:Static local:HudWindow.FrameWidth}" Height="{x:Static local:HudWindow.FrameHeight}">
      <local:HudCard x:Name="Card" DataContext="{Binding Display}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Viewbox>
</Window>
