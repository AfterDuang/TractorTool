<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TractorTool.Plugins.SystemHud"
             x:Class="TractorTool.Plugins.SystemHud.HudCard" x:DataType="local:HudDisplay"
             FontFamily="Segoe UI, Microsoft YaHei UI">
  <Border Width="{x:Static local:HudSettings.CardWidth}" Height="{x:Static local:HudSettings.CardHeight}"
          Padding="32,14" CornerRadius="52" Background="#000000" BorderBrush="#28FFFFFF" BorderThickness="1">
    <Grid RowDefinitions="16,32,16,4" RowSpacing="2" VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}" Foreground="#A1A1AA" FontSize="12" LineHeight="16"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
      <TextBlock Grid.Row="1" Text="{Binding Value}" Foreground="{Binding Accent}"
                 FontSize="26" FontWeight="SemiBold" LineHeight="32" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
      <TextBlock Grid.Row="2" Text="{Binding Detail}" Foreground="#A1A1AA" FontSize="12" LineHeight="16"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
      <ProgressBar Grid.Row="3" Height="2" VerticalAlignment="Center" Minimum="0" Maximum="100"
                   Value="{Binding Progress}" IsVisible="{Binding HasPercent}"
                   Foreground="{Binding Accent}" Background="#2C2C2E" />
    </Grid>
  </Border>
</UserControl>
