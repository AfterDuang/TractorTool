<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TractorTool.Plugins.SystemHud" x:Class="TractorTool.Plugins.SystemHud.HudView" x:DataType="local:HudModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="28,26,28,20" Spacing="6">
      <TextBlock Text="系统数据HUD" Classes="pageTitle" />
      <TextBlock Text="选择指标，编辑桌面状态显示。" Classes="muted" />
    </StackPanel>
    <ScrollViewer x:Name="WorkspaceScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
      <Grid x:Name="Workspace" ColumnDefinitions="400,*" ColumnSpacing="24" RowSpacing="20" Margin="28,0,28,0">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <TextBlock VerticalAlignment="Center" FontSize="22" Text="编辑预览" Height="40" Classes="sectionTitle" />
          <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <Border Classes="card" VerticalAlignment="Top" Margin="0,0,0,12">
              <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding RuntimeState}" Classes="sectionTitle" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ActiveProfileName, StringFormat='当前方案：{0}'}" Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
                <Grid x:Name="RuntimeControls" ColumnDefinitions="*,*" ColumnSpacing="16">
                  <ToggleSwitch x:Name="VisibilityToggle" Content="显示 HUD" IsChecked="{Binding IsHudVisible, Mode=TwoWay}" IsEnabled="{Binding CanControl}" OnContent="已显示" OffContent="已隐藏" />
                  <ToggleSwitch x:Name="PauseToggle" Grid.Column="1" Content="暂停更新" IsChecked="{Binding IsPaused, Mode=TwoWay}" IsEnabled="{Binding CanControl}" OnContent="已暂停" OffContent="未暂停" />
                </Grid>
                <TextBlock Text="{Binding StartupError}" IsVisible="{Binding HasStartupError}" TextWrapping="Wrap" Foreground="{DynamicResource AppLogErrorBrush}" />
                <StackPanel Spacing="8" Margin="0,12,0,0">
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <local:HudCard Animate="{Binding $parent[UserControl].((local:HudModel)DataContext).MotionEnabled}" DataContext="{Binding EditorDisplay}" />
                  </Viewbox>
                  <TextBlock Text="示例数据 · 随右侧编辑更新；保存后应用到桌面。" Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding PlacementHint}" Classes="caption" TextWrapping="Wrap" />
                <Border Height="1" Margin="0,12" Background="{DynamicResource AppBorderBrush}" />
                <StackPanel x:Name="RotationPanel" Spacing="12">
                  <TextBlock Text="自动轮播" Classes="sectionTitle" />
                  <TextBlock Text="所有方案共用，修改后立即保存。" Classes="caption" TextWrapping="Wrap" />
                  <ToggleSwitch x:Name="RotationToggle" Content="依次切换已保存的方案" IsChecked="{Binding RotateProfiles}" OnContent="已开启" OffContent="已关闭" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="每个方案停留" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Width="152" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <NumericUpDown x:Name="RotationInterval" Value="{Binding RotationSeconds}" Minimum="3" Maximum="300" Increment="1" FormatString="0" ParsingNumberStyle="Integer" AutomationProperties.Name="每个方案停留秒数" />
                      <TextBlock Grid.Column="1" Text="秒" VerticalAlignment="Center" />
                    </Grid>
                  </Grid>
                  <TextBlock Text="{Binding RotationStatus}" TextWrapping="Wrap" />
                  <TextBlock Text="轮播顺序" Classes="caption" />
                  <TextBlock Text="{Binding RotationOrder}" TextWrapping="Wrap" />
                  <Button Content="下一个方案" Command="{Binding NextProfileCommand}" HorizontalAlignment="Left" />
                  <TextBlock Text="轮播切换桌面 HUD；上方预览保留正在编辑的方案。" Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
        <Grid RowDefinitions="Auto,*" Grid.Column="1" RowSpacing="12" x:Name="EditorPanel">
          <TextBlock VerticalAlignment="Center" FontSize="22" Text="显示方案" Height="40" Classes="sectionTitle" />
          <ScrollViewer x:Name="ProfileScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <StackPanel Spacing="12" Margin="0,0,12,12">
              <StackPanel Spacing="8">
                <WrapPanel>
                  <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanSwitchProfile}" MinWidth="240" MaxWidth="400" Margin="0,0,12,8" AutomationProperties.Name="选择要编辑的方案">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="local:HudProfile">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="新增" Command="{Binding AddProfileCommand}" Margin="0,0,8,8" />
                  <Button Content="复制" Command="{Binding CopyProfileCommand}" Margin="0,0,8,8" />
                  <Button Content="删除" Command="{Binding DeleteProfileCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel>
                  <Button Content="保存并使用" Classes="accent" Command="{Binding SaveProfileCommand}" Margin="0,0,8,8" />
                  <Button Content="撤销修改" Command="{Binding RevertProfileCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="有未保存的修改，保存或撤销后可以切换方案。" Classes="caption" IsVisible="{Binding HasDraftChanges}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ProfileError}" TextWrapping="Wrap" Foreground="{DynamicResource AppLogErrorBrush}" />
              </StackPanel>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="显示什么" Classes="sectionTitle" />
                  <TextBlock Text="方案名称" />
                  <TextBox Text="{Binding ProfileName}" MaxLength="40" AutomationProperties.Name="方案名称" />
                  <TextBlock Text="数据指标" />
                  <ComboBox ItemsSource="{Binding Metrics}" SelectedIndex="{Binding Metric}" HorizontalAlignment="Stretch" AutomationProperties.Name="方案指标" />
                  <Grid ColumnDefinitions="Auto,152,*" ColumnSpacing="12" IsVisible="{Binding IsPollingMetric}">
                    <TextBlock Text="采样间隔" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <NumericUpDown x:Name="SamplingInterval" Value="{Binding RefreshSeconds}" Minimum="0.2" Maximum="600" Increment="0.2" FormatString="0.##" AutomationProperties.Name="当前方案采样间隔秒数" />
                      <TextBlock Grid.Column="1" Text="秒" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="0.2–600 秒" Classes="caption" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding SamplingHint}" Classes="caption" TextWrapping="Wrap" />
                  <StackPanel Spacing="8" IsVisible="{Binding HasRequestAddress}">
                    <TextBlock Text="请求地址" />
                    <TextBox Text="{Binding Address}" PlaceholderText="{Binding AddressHint}" MaxLength="2048" AutomationProperties.Name="请求地址" />
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding IsProbeMetric}">
                    <ComboBox ItemsSource="{Binding ProbeProtocols}" SelectedIndex="{Binding ProbeProtocol}" HorizontalAlignment="Stretch" AutomationProperties.Name="网络探测协议" />
                    <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" IsVisible="{Binding IsTcpProbe}" AutomationProperties.Name="TCP 端口" />
                    <TextBlock Text="ICMP 无回应不代表服务离线；TCP 只验证端口连接，不代表业务正常。" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding IsJsonMetric}">
                    <TextBlock Text="JSON 字段路径" />
                    <TextBox Text="{Binding JsonPointer}" PlaceholderText="例如 /data/temperature 或 /items/0/value" MaxLength="256" AutomationProperties.Name="JSON 字段路径" />
                    <TextBlock Text="留空读取响应的单个值；/ 分隔字段，数组下标从 0 开始。字段名中的 / 写作 ~1，~ 写作 ~0。HTTP 只做 GET，不携带登录信息，支持公开或本机接口。" Classes="caption" TextWrapping="Wrap" />
                    <CheckBox Content="这是 0–100 的百分比" IsChecked="{Binding JsonPercentage}" />
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding IsHardwareMetric}">
                    <Button Content="检测传感器" Command="{Binding ScanSensorsCommand}" HorizontalAlignment="Left" />
                    <ComboBox ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor}" HorizontalAlignment="Stretch" AutomationProperties.Name="硬件传感器">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:SensorChoice">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding SensorStatus}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding IsDeepSeekMetric}">
                    <TextBlock Text="币种" />
                    <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" HorizontalAlignment="Stretch" AutomationProperties.Name="余额币种" />
                    <TextBlock Text="API Key 在插件设置中保存。这里只读取官方余额接口，不调用模型。" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding IsDiskMetric}">
                    <TextBlock Text="本地盘符" />
                    <TextBox Text="{Binding Drive}" MaxLength="3" PlaceholderText="C:\" AutomationProperties.Name="本地盘符" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Expander x:Name="AppearanceExpander" Header="文字与颜色" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid x:Name="AppearanceGrid" ColumnDefinitions="*,*" ColumnSpacing="24" RowSpacing="20" Margin="0,12,0,0">
                  <StackPanel x:Name="TextSettings" Spacing="10">
                    <TextBlock Text="显示文字" Classes="sectionTitle" />
                    <TextBlock Text="可直接写文字，也可用变量显示实时数据。" Classes="caption" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                      <TextBlock Text="标题" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding TitleTemplate}" MaxLength="60" AutomationProperties.Name="标题模板" />
                      <TextBlock Grid.Row="1" Text="数值" VerticalAlignment="Center" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ValueTemplate}" MaxLength="80" AutomationProperties.Name="数值模板" />
                      <TextBlock Grid.Row="2" Text="说明" VerticalAlignment="Center" />
                      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DetailTemplate}" MaxLength="160" AutomationProperties.Name="说明模板" />
                    </Grid>
                    <TextBlock Text="变量：{label} 指标名、{value} 显示值、{detail} 说明、{percent} 百分比数字、{name} 方案名、{unit} 单位、{updated} 读取时间。" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel x:Name="ColorSettings" Grid.Column="1" Spacing="10">
                    <TextBlock Text="显示颜色" Classes="sectionTitle" />
                    <TextBlock Text="点击色块选颜色，左侧预览同步更新。" Classes="caption" TextWrapping="Wrap" />
                    <WrapPanel>
                      <StackPanel Spacing="6" Margin="0,0,16,0">
                        <TextBlock Text="常规颜色" />
                        <ColorPicker x:Name="AccentPicker" Color="{Binding AccentColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False"
                                     IsColorModelVisible="False" IsColorComponentsVisible="False" Width="132" HorizontalAlignment="Left" AutomationProperties.Name="选择常规颜色" />
                      </StackPanel>
                      <StackPanel IsVisible="{Binding SupportsColorRule}">
                        <StackPanel Spacing="6" IsVisible="{Binding RuleEnabled}">
                          <TextBlock Text="提醒颜色" />
                          <ColorPicker x:Name="RulePicker" Color="{Binding RuleColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False"
                                       IsColorModelVisible="False" IsColorComponentsVisible="False" Width="132" HorizontalAlignment="Left" AutomationProperties.Name="选择提醒颜色" />
                        </StackPanel>
                      </StackPanel>
                    </WrapPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding SupportsColorRule}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="达到条件时变色" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RuleEnabled}" OnContent="已开启" OffContent="已关闭" AutomationProperties.Name="达到条件时变色" />
                      </Grid>
                      <Grid ColumnDefinitions="*,144" ColumnSpacing="10" IsVisible="{Binding RuleEnabled}">
                        <ComboBox ItemsSource="{Binding Comparisons}" SelectedIndex="{Binding Comparison}" HorizontalAlignment="Stretch" AutomationProperties.Name="何时变色" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <NumericUpDown x:Name="ColorThreshold" Value="{Binding Threshold}" Minimum="0" Maximum="100" Increment="1" FormatString="0.#" AutomationProperties.Name="变色界限百分比" />
                          <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" />
                        </Grid>
                      </Grid>
                    </StackPanel>
                    <TextBlock Text="{Binding ColorRuleHint}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Classes="caption" Margin="28,12,28,24" />
  </Grid>
</UserControl>
