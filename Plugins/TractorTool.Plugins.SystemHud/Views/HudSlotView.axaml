<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TractorTool.Plugins.SystemHud"
             x:Class="TractorTool.Plugins.SystemHud.HudSlotView" x:Name="Slot" x:DataType="local:HudSlotDisplay"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True">
  <Grid DataContext="{Binding #Slot.Item}">
    <!-- Icons use a 24-unit canvas, including room for the stroke outside the geometry. -->
    <Viewbox IsVisible="{Binding IsIcon}" Width="{Binding #Slot.IconSize}" Height="{Binding #Slot.IconSize}">
      <Path Data="{Binding Icon}" Width="24" Height="24" Stretch="None" Stroke="{Binding Accent}" StrokeThickness="1.7" />
    </Viewbox>
    <Grid IsVisible="{Binding IsRing}" Width="28" Height="28">
      <Ellipse Stroke="#38383B" StrokeThickness="2.5" />
      <Arc StartAngle="-90" SweepAngle="{Binding SweepAngle}" Stroke="{Binding Accent}" StrokeThickness="2.5" />
      <Viewbox Width="12" Height="12">
        <Path Data="{Binding Icon}" Width="24" Height="24" Stretch="None" Stroke="{Binding Accent}" StrokeThickness="2.6" />
      </Viewbox>
    </Grid>
    <TextBlock IsVisible="{Binding IsText}" Text="{Binding Text}"
               TextAlignment="{Binding $parent[local:HudSlotView].TextAlignment}"
               TextWrapping="{Binding $parent[local:HudSlotView].TextWrapping}" TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center" />
  </Grid>
</UserControl>
