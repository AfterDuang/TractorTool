<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TractorTool.Plugins.SystemHud"
             x:Class="TractorTool.Plugins.SystemHud.HudSlotView" x:DataType="local:HudSlotDisplay">
  <Grid ToolTip.Tip="{Binding Description}">
    <Path IsVisible="{Binding IsIcon}" Data="{Binding Icon}" Width="20" Height="20"
          Stretch="Uniform" Stroke="{Binding Accent}" StrokeThickness="1.7" />
    <Grid IsVisible="{Binding IsRing}" Width="28" Height="28">
      <Ellipse Stroke="#38383B" StrokeThickness="2.5" />
      <Arc StartAngle="-90" SweepAngle="{Binding SweepAngle}" Stroke="{Binding Accent}" StrokeThickness="2.5" />
      <Path Data="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Accent}" StrokeThickness="1.3" />
    </Grid>
    <TextBlock IsVisible="{Binding IsText}" Text="{Binding Text}" Foreground="{Binding Accent}"
               TextWrapping="{Binding $parent[local:HudSlotView].TextWrapping}" TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center" />
  </Grid>
</UserControl>
