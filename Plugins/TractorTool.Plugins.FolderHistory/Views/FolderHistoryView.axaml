<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.Plugins.FolderHistory.ViewModels"
             xmlns:processing="using:TractorTool.Plugins.FolderHistory.Processing"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="TractorTool.Plugins.FolderHistory.Views.FolderHistoryView" x:DataType="vm:FolderHistoryViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox#HistoryList ListBoxItem">
      <Setter Property="ContextFlyout">
        <fa:FAMenuFlyout Opening="MenuOpening" />
      </Setter>
    </Style>
    <Style Selector="ListBox.rows">
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="AutoScrollToSelectedItem" Value="False" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="4,1" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="MinWidth" Value="26" /><Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="3,0" />
    </Style>
    <Style Selector="TextBlock.line">
      <Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="SelectableTextBlock.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" /><Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="versionLabel" x:DataType="vm:VersionItem">
      <TextBlock Classes="line" Text="{Binding Title}" />
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="0,0,6,10" RowDefinitions="Auto,*" RowSpacing="8">
    <StackPanel Spacing="5">
      <WrapPanel ItemSpacing="6" LineSpacing="4" IsEnabled="{Binding !IsBusy}">
        <ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" IsVisible="{Binding HasFolder}"
                  MinWidth="116" MaxWidth="230" ToolTip.Tip="{Binding SelectedFolder?.Root}" AutomationProperties.Name="切换受保护的文件夹">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:FolderItem">
            <TextBlock Classes="line" Text="{Binding Name}" ToolTip.Tip="{Binding Root}" />
          </DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="添加文件夹…" Click="AddFolder" />
        <Button x:Name="CreateSnapshotButton" Content="创建快照…" Click="CreateSnapshot" IsEnabled="{Binding CanSave}" IsVisible="{Binding HasFolder}" Classes="accent" />
        <Button x:Name="MoreButton" Content="更多 ▾" IsVisible="{Binding HasFolder}" AutomationProperties.Name="文件夹操作">
          <Button.Flyout><fa:FAMenuFlyout Opening="MenuOpening" /></Button.Flyout>
        </Button>
        <TextBlock Classes="caption line" Text="{Binding SelectedFolder?.Info.Status}" ToolTip.Tip="{Binding FolderSummary}" />
      </WrapPanel>
      <TextBlock Classes="caption line" Text="{Binding SelectedFolder?.Root}" ToolTip.Tip="{Binding FolderSummary}" IsVisible="{Binding HasFolder}" />
      <StackPanel IsVisible="{Binding IsBusy}" Spacing="3">
        <TextBlock Classes="caption" Text="{Binding BusyMessage}" />
        <ProgressBar IsIndeterminate="True" Height="3" AutomationProperties.Name="历史操作进度" />
      </StackPanel>
      <SelectableTextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextWrapping="Wrap" />
      <SelectableTextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource AppLogErrorBrush}" />
      <Button Content="处理未完成的恢复…" Click="HandlePendingRestore" IsVisible="{Binding HasPendingRestore}" IsEnabled="{Binding !IsBusy}" />
      <Button Content="继续未完成的清理…" Click="ResumeCleanup" IsVisible="{Binding HasPendingCleanup}" IsEnabled="{Binding !IsBusy}" />
    </StackPanel>
    <TextBlock Grid.Row="1" Classes="muted" Text="添加一个文件夹，开始保存它的版本。" IsVisible="{Binding !HasFolder}" />
    <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding HasFolder}" IsEnabled="{Binding !IsBusy}">
      <Grid ColumnDefinitions="0.32*,5,*">
        <Grid Margin="6" RowDefinitions="Auto,*" RowSpacing="4">
          <TextBlock Text="文件树" FontWeight="SemiBold" Margin="5,4" ToolTip.Tip="历史中出现过的文件。按 Ctrl、Shift 或拖动鼠标可多选。" />
          <Grid Grid.Row="1" x:Name="TreeArea" ClipToBounds="True">
            <ListBox x:Name="FileTree" Classes="rows" SelectionMode="Multiple" AutomationProperties.Name="已记录的文件树"
                     Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TreeItem">
                  <Grid Margin="{Binding Indent}" ColumnDefinitions="22,18,*" ColumnSpacing="3" ToolTip.Tip="{Binding Path}">
                    <Button Classes="quiet small" Padding="0" MinWidth="18" MinHeight="22" IsVisible="{Binding HasChildren}"
                            Click="ToggleNode" AutomationProperties.Name="展开或折叠文件夹">
                      <Grid><TextBlock Text="▸" IsVisible="{Binding !IsExpanded}" /><TextBlock Text="▾" IsVisible="{Binding IsExpanded}" /></Grid>
                    </Button>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                      <PathIcon Width="14" Height="14" IsVisible="{Binding IsDirectory}"
                                Data="M1,3 L6,3 L8,5 L15,5 L15,13 L1,13 Z" />
                      <PathIcon Width="12" Height="14" IsVisible="{Binding !IsDirectory}"
                                Data="M3,1 L10,1 L14,5 L14,15 L3,15 Z M4.5,2.5 L4.5,13.5 L12.5,13.5 L12.5,6 L9,6 L9,2.5 Z" />
                    </Grid>
                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="line" Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="caption line" Text=" 旧" IsVisible="{Binding IsHistoricalOnly}" ToolTip.Tip="仅在以前的保存中出现" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
              <Border x:Name="SelectionBox" IsVisible="False" BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="1">
                <Border Background="{DynamicResource SystemAccentColor}" Opacity="0.16" />
              </Border>
            </Canvas>
          </Grid>
        </Grid>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" Background="{DynamicResource AppBorderBrush}" />
        <Grid Grid.Column="2" Margin="8,4" RowDefinitions="Auto,Auto,*" RowSpacing="4">
          <TextBlock Classes="line" FontWeight="SemiBold" Text="{Binding ScopeTitle}" ToolTip.Tip="{Binding ScopeTitle}" />
          <TabStrip x:Name="ModeTabs" Grid.Row="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                    AutomationProperties.Name="查看方式" AutomationProperties.ControlTypeOverride="Tab">
            <TabStripItem Content="历史记录" AutomationProperties.ControlTypeOverride="TabItem" />
            <TabStripItem Content="内容对比" AutomationProperties.ControlTypeOverride="TabItem" />
          </TabStrip>
          <TextBlock Grid.Row="2" IsVisible="{Binding !HasVersion}" Classes="muted" Text="{Binding EmptyTimelineMessage}" Margin="4,8" />
          <Grid Grid.Row="2" IsVisible="{Binding HasVersion}">
            <Grid x:Name="HistoryPane" RowDefinitions="Auto,*" IsVisible="{Binding !IsComparing}">
              <Grid Margin="7,2" ColumnDefinitions="1.15*,1.15*,*,32" ColumnSpacing="5">
                <TextBlock Text="保存时间" Classes="caption line" /><TextBlock Grid.Column="1" Text="说明" Classes="caption line" />
                <TextBlock Grid.Column="2" Text="变化" Classes="caption line" />
              </Grid>
              <ListBox x:Name="HistoryList" Grid.Row="1" Classes="rows" ItemsSource="{Binding TimelineVersions}"
                       SelectedItem="{Binding SelectedVersion}" AutomationProperties.Name="所选范围的历史记录">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:VersionItem">
                    <Grid ColumnDefinitions="1.15*,1.15*,*,32" ColumnSpacing="5" Background="Transparent">
                      <TextBlock Classes="line" Text="{Binding Title}" ToolTip.Tip="{Binding Title}" />
                      <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                        <TextBlock Text="★ " IsVisible="{Binding Pinned}" Classes="line" ToolTip.Tip="重要版本" />
                        <TextBlock Classes="line" Grid.Column="1" Text="{Binding Note}" ToolTip.Tip="{Binding Note}" />
                      </Grid>
                      <TextBlock Classes="line caption" Grid.Column="2" Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" />
                      <Button Grid.Column="3" Content="⋯" Classes="quiet small" AutomationProperties.Name="此版本的操作">
                        <Button.Flyout><fa:FAMenuFlyout Opening="MenuOpening" /></Button.Flyout>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <Grid x:Name="ComparisonPane" RowDefinitions="Auto,*" IsVisible="{Binding IsComparing}" RowSpacing="5">
              <WrapPanel ItemSpacing="6" LineSpacing="3">
                <ComboBox ItemsSource="{Binding ComparisonBases}" SelectedItem="{Binding ComparisonBase}" ItemTemplate="{StaticResource versionLabel}"
                          PlaceholderText="首次保存前" MaxWidth="200" AutomationProperties.Name="较早的保存时间" />
                <TextBlock Classes="line" Text="→" />
                <ComboBox ItemsSource="{Binding TimelineVersions}" SelectedItem="{Binding SelectedVersion}" ItemTemplate="{StaticResource versionLabel}"
                          MaxWidth="200" AutomationProperties.Name="所看版本的保存时间" />
                <Button Classes="quiet" Content="返回变化列表" Click="BackToChanges" IsVisible="{Binding CanReturnToChanges}" />
                <Button Classes="quiet" Content="查看上次保存的版本" Command="{Binding GoToLastPresentVersionCommand}" IsVisible="{Binding CanGoToLastPresentVersion}" />
              </WrapPanel>
              <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding ShowChangeList}">
                <TextBlock Margin="4,2" Classes="caption" Text="{Binding ComparisonSummary}" />
                <ListBox Classes="rows" Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                         AutomationProperties.Name="发生变化的文件">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItem">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" ToolTip.Tip="{Binding Path}">
                        <TextBlock Classes="line" Text="{Binding Kind}" />
                        <TextBlock Classes="line" Grid.Column="1" Text="{Binding Path}" />
                        <TextBlock Classes="caption line" Grid.Column="2" Text="{Binding SizeLabel}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
              <Grid Grid.Row="1" IsVisible="{Binding HasFileDetail}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="3">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBlock Classes="line" Text="{Binding DetailPath}" FontWeight="SemiBold" ToolTip.Tip="{Binding DetailPath}" />
                  <TextBlock Grid.Column="1" Classes="caption line" Text="{Binding SelectedFileSummary}" />
                </Grid>
                <TextBlock Grid.Row="1" Classes="caption" Text="{Binding TextSummary}" IsVisible="{Binding HasTextPreview}" />
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="1"><TextBlock Classes="line" Text="{Binding BeforeTitle}" /><TextBlock Classes="caption" Text="{Binding BeforeFileInfo}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="1"><TextBlock Classes="line" Text="{Binding AfterTitle}" /><TextBlock Classes="caption" Text="{Binding AfterFileInfo}" /></StackPanel>
                </Grid>
                <ListBox Grid.Row="3" Classes="rows" ItemsSource="{Binding TextLines}" AutomationProperties.Name="左右并排的文本内容">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="processing:TextDiffLine">
                      <Grid ColumnDefinitions="*,1,*" ColumnSpacing="3">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" MinHeight="20">
                          <Border Grid.ColumnSpan="2" Background="{DynamicResource AppLogErrorBrush}" Opacity="0.16" IsVisible="{Binding BeforeChanged}" />
                          <TextBlock Text="{Binding BeforeLine}" Classes="caption" MinWidth="22" TextAlignment="Right" />
                          <SelectableTextBlock Grid.Column="1" Classes="code" Text="{Binding BeforeText}" />
                        </Grid>
                        <Border Grid.Column="1" Background="{DynamicResource AppBorderBrush}" />
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="5">
                          <Border Grid.ColumnSpan="2" Background="{DynamicResource AppLogInfoBrush}" Opacity="0.16" IsVisible="{Binding AfterChanged}" />
                          <TextBlock Text="{Binding AfterLine}" Classes="caption" MinWidth="22" TextAlignment="Right" />
                          <SelectableTextBlock Grid.Column="1" Classes="code" Text="{Binding AfterText}" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
