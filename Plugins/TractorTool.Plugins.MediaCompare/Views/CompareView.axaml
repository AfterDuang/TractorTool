<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TractorTool.Plugins.MediaCompare.ViewModels"
             xmlns:views="using:TractorTool.Plugins.MediaCompare.Views"
             x:Class="TractorTool.Plugins.MediaCompare.Views.CompareView" x:DataType="vm:CompareViewModel"
             Focusable="True">
  <Grid Margin="24,16,24,16" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <TextBlock Text="AB 审片" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Content="适合" Click="FitView" ToolTip.Tip="显示完整画面并居中（双击画面也可重置）" />
        <Button Content="填满画布" Click="FillView" ToolTip.Tip="保持比例，裁去超出边缘的部分，使 A/B 各自铺满画布" />
        <Button Content="1:1" Click="ActualSize" ToolTip.Tip="一个源像素对应一个屏幕像素；A/B 分别使用各自分辨率" AutomationProperties.Name="原始像素" />
        <Button x:Name="HelpButton" Content="说明" Margin="10,0,0,0">
          <Button.Flyout>
            <Flyout>
              <StackPanel Width="300" Spacing="10">
                <TextBlock Text="画面对比" FontWeight="SemiBold" />
                <TextBlock Text="滚轮缩放，拖动画面联动平移；双击恢复完整画面。空格播放或暂停视频与序列帧。" TextWrapping="Wrap" />
                <TextBlock Text="当前为 SDR 8 位预览，未做显示器色彩校准，不适用于 HDR / Log 色彩评判。" Classes="caption" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RendererStatus}" Classes="caption" TextWrapping="Wrap" />
                <Separator />
                <TextBlock Text="媒体运行库已随插件提供，无需另行下载。" TextWrapping="Wrap" />
                <TextBlock Text="GStreamer 1.28.9 · 插件私有运行库" Classes="caption" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,*" Background="{DynamicResource AppCardBrush}">
          <Border x:Name="SourceA" Padding="10" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource AppBorderBrush}" DragDrop.AllowDrop="True">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="A" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" />
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding AName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding AName}" />
                <TextBlock Text="{Binding ASummary}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ADetails}" />
              </StackPanel>
              <Button Grid.Column="2" Content="打开" Tag="A" Click="ChooseMedia" IsEnabled="{Binding CanOperate}" VerticalAlignment="Center" AutomationProperties.Name="打开 A 素材" />
              <Button x:Name="SourceAOptions" Grid.Column="3" Content="⋯" VerticalAlignment="Center" ToolTip.Tip="A 素材信息与图片序列" AutomationProperties.Name="A 素材信息与图片序列">
                <Button.Flyout>
                  <Flyout>
                    <StackPanel Width="280" Spacing="10">
                      <TextBlock Text="A 素材" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding AName}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ADetails}" Classes="caption" TextWrapping="Wrap" />
                      <Separator />
                      <TextBlock Text="打开图片序列" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="序列帧率（fps）" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SequenceFrameRate}" Minimum="1" Maximum="240" Increment="1" FormatString="0.###" Width="108" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="A 新序列的帧率" />
                      </Grid>
                      <Button Content="选择序列首帧…" Tag="A" Click="ChooseSequence" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
          <Border x:Name="SourceB" Grid.Column="1" Padding="10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}" DragDrop.AllowDrop="True">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="B" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" />
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding BName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding BName}" />
                <TextBlock Text="{Binding BSummary}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BDetails}" />
              </StackPanel>
              <Button Grid.Column="2" Content="打开" Tag="B" Click="ChooseMedia" IsEnabled="{Binding CanOperate}" VerticalAlignment="Center" AutomationProperties.Name="打开 B 素材" />
              <Button x:Name="SourceBOptions" Grid.Column="3" Content="⋯" VerticalAlignment="Center" ToolTip.Tip="B 素材信息与图片序列" AutomationProperties.Name="B 素材信息与图片序列">
                <Button.Flyout>
                  <Flyout>
                    <StackPanel Width="280" Spacing="10">
                      <TextBlock Text="B 素材" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding BName}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding BDetails}" Classes="caption" TextWrapping="Wrap" />
                      <Separator />
                      <TextBlock Text="打开图片序列" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="序列帧率（fps）" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding SequenceFrameRate}" Minimum="1" Maximum="240" Increment="1" FormatString="0.###" Width="108" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="B 新序列的帧率" />
                      </Grid>
                      <Button Content="选择序列首帧…" Tag="B" Click="ChooseSequence" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="1" Background="#111111" MinHeight="120">
          <views:ComparePreview x:Name="Preview" />
          <Border Width="1" HorizontalAlignment="Center" Background="#555555" IsHitTestVisible="False" />
          <TextBlock Text="打开 A / B 素材开始比较&#x0a;也可以将文件拖到上方对应区域" Foreground="#B0B0B0" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasMedia}" IsHitTestVisible="False" />
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding HasTimeline}">
      <TextBlock Text="{Binding PositionText}" FontFamily="Consolas" VerticalAlignment="Center" />
      <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="{Binding TimelineMaximum}"
              Value="{Binding PositionSeconds, Mode=OneWay}" IsEnabled="{Binding CanSeek}" SmallChange="0.1" LargeChange="1"
              AutomationProperties.Name="共同播放时间" ToolTip.Tip="拖动定位；方向键移动 0.1 秒，Page Up/Down 移动 1 秒" />
      <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontFamily="Consolas" VerticalAlignment="Center" ToolTip.Tip="媒体估计总时长；仅有音频的尾段可能没有可比较画面" />
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
      <Button x:Name="PlayButton" Content="{Binding PlayLabel}" Command="{Binding TogglePlayCommand}" Click="FocusPreview" MinWidth="80" ToolTip.Tip="{Binding PlaybackHint}" />
      <TextBlock Grid.Column="1" Text="{Binding PlaybackHint}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTimeline}">
        <TextBlock Text="声音" VerticalAlignment="Center" />
        <ComboBox x:Name="AudioChoice" SelectedIndex="{Binding SelectedAudio, Mode=OneWay}" SelectionChanged="AudioChanged" MinWidth="112" AutomationProperties.Name="试听声音">
          <ComboBoxItem Content="静音" /><ComboBoxItem Content="只听 A" /><ComboBoxItem Content="只听 B" />
        </ComboBox>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="4" Spacing="4" IsVisible="{Binding ShowStatus}">
      <TextBlock Text="{Binding Status}" IsVisible="{Binding IsBusy}" Classes="caption" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource AppLogErrorBrush}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
