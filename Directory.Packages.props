<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TractorToolAvaloniaVersion>12.1.6</TractorToolAvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="$(TractorToolAvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="$(TractorToolAvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(TractorToolAvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(TractorToolAvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(TractorToolAvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(TractorToolAvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
