<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
    <Reference Include="TractorTool"><HintPath>$(HostSdkDir)/TractorTool.dll</HintPath></Reference>
    <Reference Include="TractorTool.Core"><HintPath>$(HostSdkDir)/TractorTool.Core.dll</HintPath></Reference>
    <Reference Include="TractorTool.Contracts"><HintPath>$(HostSdkDir)/TractorTool.Contracts.dll</HintPath></Reference>
    <Reference Include="TractorTool.UI"><HintPath>$(HostSdkDir)/TractorTool.UI.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(DesignTimeBuild)' == 'true'">
    <ProjectReference Include="../../TractorTool/TractorTool.csproj" />
    <ProjectReference Include="../../TractorTool.Core/TractorTool.Core.csproj" />
    <ProjectReference Include="../../TractorTool.Contracts/TractorTool.Contracts.csproj" />
    <ProjectReference Include="../../TractorTool.UI/TractorTool.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <Target Name="RequirePublishedHost" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true' And !Exists('$(HostSdkDir)/TractorTool.dll')">
    <Error Text="Integration checks require -p:HostSdkDir pointing to the already published host." />
  </Target>
</Project>
