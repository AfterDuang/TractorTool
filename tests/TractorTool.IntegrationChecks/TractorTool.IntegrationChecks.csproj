<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup Condition="'$(HostSdkDir)' != ''">
    <Reference Include="TractorTool"><HintPath>$(HostSdkDir)/TractorTool.dll</HintPath></Reference>
    <Reference Include="TractorTool.Core"><HintPath>$(HostSdkDir)/TractorTool.Core.dll</HintPath></Reference>
    <Reference Include="TractorTool.Contracts"><HintPath>$(HostSdkDir)/TractorTool.Contracts.dll</HintPath></Reference>
    <Reference Include="TractorTool.UI"><HintPath>$(HostSdkDir)/TractorTool.UI.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HostSdkDir)' == ''">
    <ProjectReference Include="../../TractorTool/TractorTool.csproj" />
    <ProjectReference Include="../../TractorTool.Core/TractorTool.Core.csproj" />
    <ProjectReference Include="../../TractorTool.Contracts/TractorTool.Contracts.csproj" />
    <ProjectReference Include="../../TractorTool.UI/TractorTool.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <Target Name="RequirePublishedHost" BeforeTargets="ResolveReferences" Condition="'$(HostSdkDir)' != ''">
    <Error Condition="!Exists('$(HostSdkDir)/TractorTool.dll') Or !Exists('$(HostSdkDir)/TractorTool.Core.dll') Or !Exists('$(HostSdkDir)/TractorTool.Contracts.dll') Or !Exists('$(HostSdkDir)/TractorTool.UI.dll')"
           Text="HostSdkDir must contain the published host, Core, Contracts and UI DLLs; source references are not a fallback." />
  </Target>
</Project>
