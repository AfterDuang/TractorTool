<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <!-- Local development uses public SDK projects; Verify-PluginHost explicitly rebuilds against a published SDK. -->
  <ItemGroup Condition="'$(HostSdkDir)' != ''">
    <Reference Include="TractorTool.Contracts"><HintPath>$(HostSdkDir)/TractorTool.Contracts.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TractorTool.UI"><HintPath>$(HostSdkDir)/TractorTool.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HostSdkDir)' == ''">
    <ProjectReference Include="../../TractorTool.Contracts/TractorTool.Contracts.csproj" Private="false" />
    <ProjectReference Include="../../TractorTool.UI/TractorTool.UI.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile-only public Avalonia API, same version as the host; never ship a second runtime. -->
    <PackageReference Include="Avalonia" Version="12.1.6" IncludeAssets="compile" PrivateAssets="all" />
    <ProjectReference Include="../FixtureDependency/FixtureDependency.csproj" />
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePublishedSdk" BeforeTargets="ResolveReferences" Condition="'$(HostSdkDir)' != ''">
    <Error Condition="!Exists('$(HostSdkDir)/TractorTool.Contracts.dll') Or !Exists('$(HostSdkDir)/TractorTool.UI.dll')"
           Text="HostSdkDir 必须包含已发布的 Contracts/UI DLL；无效路径不会回退到源码引用。" />
  </Target>
</Project>
