<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TractorTool.Contracts/TractorTool.Contracts.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
  <Target Name="GenerateUiAvaloniaVersion" AfterTargets="PrepareForBuild" BeforeTargets="BeforeCompile;CoreCompile">
    <Error Condition="'$(TractorToolAvaloniaVersion)' == ''" Text="缺少集中配置的 Avalonia 版本。" />
    <PropertyGroup>
      <_UiVersionFile>$(IntermediateOutputPath)UiApi.AvaloniaVersion.g.cs</_UiVersionFile>
      <_UiVersionSource>namespace TractorTool.UI%3B
public static partial class UiApi
{
    public const string AvaloniaVersion = "$(TractorToolAvaloniaVersion)"%3B
}</_UiVersionSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(_UiVersionFile)" Lines="$(_UiVersionSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_UiVersionFile)" />
      <FileWrites Include="$(_UiVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
