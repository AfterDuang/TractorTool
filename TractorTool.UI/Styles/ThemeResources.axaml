<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- App surfaces sit above the single FluentAvalonia control theme. -->
  <Color x:Key="AppLightBackgroundColor">#F5F5F7</Color>
  <Color x:Key="AppLightSidebarColor">#EEEEF1</Color>
  <Color x:Key="AppLightCardColor">#FFFFFF</Color>
  <Color x:Key="AppLightControlColor">#F8F8FA</Color>
  <Color x:Key="AppLightBorderColor">#DFDFE5</Color>
  <Color x:Key="AppLightTextColor">#24242A</Color>
  <Color x:Key="AppDarkBackgroundColor">#27272A</Color>
  <Color x:Key="AppDarkSidebarColor">#222123</Color>
  <Color x:Key="AppDarkCardColor">#323236</Color>
  <Color x:Key="AppDarkControlColor">#3B393C</Color>
  <Color x:Key="AppDarkBorderColor">#48454A</Color>
  <Color x:Key="AppDarkTextColor">#F1EFF3</Color>
  <SolidColorBrush x:Key="AppErrorBadgeBrush" Color="#C42B3A" />

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppLightBackgroundColor}" />
      <SolidColorBrush x:Key="AppSidebarBrush" Color="{StaticResource AppLightSidebarColor}" />
      <SolidColorBrush x:Key="AppCardBrush" Color="{StaticResource AppLightCardColor}" />
      <SolidColorBrush x:Key="AppControlBrush" Color="{StaticResource AppLightControlColor}" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppLightBorderColor}" />
      <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppLightTextColor}" />
      <SolidColorBrush x:Key="AppLogInfoBrush" Color="#177245" />
      <SolidColorBrush x:Key="AppLogWarningBrush" Color="#8A5A00" />
      <SolidColorBrush x:Key="AppLogErrorBrush" Color="#B42332" />
      <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#686671" />
      <SolidColorBrush x:Key="AppNavHoverBrush" Color="#E4E3E9" />
      <SolidColorBrush x:Key="AppNavSelectedBrush" Color="#DFE6EF" />
      <SolidColorBrush x:Key="AppIconBackgroundBrush" Color="#E1EBFA" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppDarkBackgroundColor}" />
      <SolidColorBrush x:Key="AppSidebarBrush" Color="{StaticResource AppDarkSidebarColor}" />
      <SolidColorBrush x:Key="AppCardBrush" Color="{StaticResource AppDarkCardColor}" />
      <SolidColorBrush x:Key="AppControlBrush" Color="{StaticResource AppDarkControlColor}" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppDarkBorderColor}" />
      <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppDarkTextColor}" />
      <SolidColorBrush x:Key="AppLogInfoBrush" Color="#6DDC91" />
      <SolidColorBrush x:Key="AppLogWarningBrush" Color="#F4CF70" />
      <SolidColorBrush x:Key="AppLogErrorBrush" Color="#FF8A90" />
      <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#B5B0BA" />
      <SolidColorBrush x:Key="AppNavHoverBrush" Color="#302D32" />
      <SolidColorBrush x:Key="AppNavSelectedBrush" Color="#343B45" />
      <SolidColorBrush x:Key="AppIconBackgroundBrush" Color="#2E3D52" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
